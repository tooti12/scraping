# ── VFS Global account ────────────────────────────────────────────────────────
VFS_EMAIL=your.vfs.email@gmail.com
VFS_PASSWORD=YourVfsPassword

# ── Gmail OTP retrieval (must be an App Password, not your account password) ──
# Generate one at: https://myaccount.google.com/apppasswords
# Paste WITHOUT spaces (e.g. "abcdefghijklmnop", not "abcd efgh ijkl mnop")
GMAIL_APP_PASSWORD=yourgmailapppassword

# ── Legacy thesemantics.co IMAP account ──────────────────────────────────────
LEGACY_EMAIL_PASSWORD=YourLegacyEmailPassword
LEGACY_EMAIL_IMAP_SERVER=thesemantics.co

# ── Twilio (WhatsApp slot-found notifications) ────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+447700000000
TWILIO_TO_NUMBER=+447700000001

# ── Residential UK proxy (VFS bot-detection bypass) ──────────────────────────
# Format: user:pass@host:port
# A fresh session id is randomized on every BrowserClient launch so each
# Chrome instance gets its own exit IP from the provider.
VFS_PROXY_URL=user-YOURUSERNAME-type-residential-session-XXXXX-country-gb-rotation-0:YourPassword@geo.g-w.info:10080
